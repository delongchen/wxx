{
  "name": "tauri-plugin-wxx-core",
  "version": "0.0.4",
  "author": {
    "name": "YUQI MAO"
  },
  "description": "",
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.js",
  "module": "./dist-js/index.js",
  "exports": {
    ".": {
      "types": "./dist-js/index.d.ts",
      "import": "./dist-js/index.js"
    },
    "./*": {
      "types": "./dist-js/*/index.d.ts",
      "import": "./dist-js/*/index.js"
    },
    "./lcu-api/*": {
      "types": "./dist-js/api/lcu-api/*.d.ts",
      "import": "./dist-js/api/lcu-api/*.js"
    }
  },
  "files": [
    "dist-js",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "yarn build",
    "pretest": "yarn build"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "react": "^18.3.1",
    "tslib": "^2.7.0",
    "typedoc": "^0.26.7",
    "typedoc-plugin-markdown": "^4.2.9",
    "yaml": "^2.5.1"
  }
}
